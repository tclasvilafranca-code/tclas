// t-clas · Piano Learning App
// Nota: los campos "tipo/estado" se guardan como String (en vez de enum)
// para mantener compatibilidad si en el futuro se usara otro motor;
// se validan en la capa de aplicacion (ver src/types.ts).
//
// Modelo de contenido: cada alumno tiene su propio repertorio de piezas
// (RepertoireEntry), asignado por su profesor/a desde una biblioteca
// compartida de piezas (Piece). Cada pieza asignada genera automaticamente
// unas lecciones semanales (Lesson) con ejercicios variados derivados de
// la musica real de esa pieza.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique // profesores: email+password. Alumnos: null (usan username+PIN)
  passwordHash String?
  username     String?  @unique // alumnos: usuario corto para entrar
  pinHash      String? // alumnos: PIN hasheado
  name         String
  role         String // "STUDENT" | "TEACHER"
  createdAt    DateTime @default(now())

  studentProfile StudentProfile?

  studentsCreated  StudentProfile[]   @relation("TeacherStudents")
  progress         Progress[]
  xpEvents         XPEvent[]
  badges           UserBadge[]
  exerciseAttempts ExerciseAttempt[]
}

model StudentProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  teacherId        String?
  teacher          User?     @relation("TeacherStudents", fields: [teacherId], references: [id])
  ageGroup         String // "KIDS" (6-11) | "TEENS" (12-17) | "ADULTS" (18+)
  birthYear        Int?
  xpTotal          Int       @default(0)
  heartsCurrent    Int       @default(5)
  heartsMax        Int       @default(5)
  heartsUpdatedAt  DateTime  @default(now())
  streakCurrent    Int       @default(0)
  streakLongest    Int       @default(0)
  lastActivityDate DateTime?
  onboarded        Boolean   @default(false)
  createdAt        DateTime  @default(now())

  repertoire RepertoireEntry[]
}

// Biblioteca compartida de piezas/partituras (reutilizable entre alumnos).
model Piece {
  id             String  @id @default(cuid())
  title          String  @unique
  composer       String  @default("")
  arranger       String  @default("")
  ageGroup       String // KIDS | TEENS | ADULTS: para quien esta pensada principalmente
  difficultyTier Int // 1 = mas facil ... N = mas dificil, para ordenar sugerencias
  defaultWeeks   Int     @default(3)
  keySignature   String // p.ej. "Do Mayor"
  timeSignature  String // p.ej. "4/4"
  seasonalTag    String? // p.ej. "christmas"
  iconEmoji      String  @default("🎵")
  content        String // JSON: PieceContent (ver src/types.ts)

  repertoireEntries RepertoireEntry[]
}

// Una pieza asignada a un alumno concreto, en su orden y fechas.
model RepertoireEntry {
  id            String    @id @default(cuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])
  pieceId       String
  piece         Piece     @relation(fields: [pieceId], references: [id])
  orderIndex    Int
  startDate     DateTime
  durationWeeks Int
  teacherNote   String    @default("")
  status        String    @default("UPCOMING") // UPCOMING | ACTIVE | COMPLETED

  lessons Lesson[]

  @@unique([studentId, orderIndex])
}

model Lesson {
  id                String          @id @default(cuid())
  repertoireEntryId String
  repertoireEntry   RepertoireEntry @relation(fields: [repertoireEntryId], references: [id])
  weekIndex         Int // semana dentro de la pieza (1..durationWeeks)
  title             String
  description       String
  xpReward          Int             @default(15)

  exercises Exercise[]
  progress  Progress[]

  @@unique([repertoireEntryId, weekIndex])
}

model Exercise {
  id          String @id @default(cuid())
  lessonId    String
  lesson      Lesson @relation(fields: [lessonId], references: [id])
  index       Int
  type        String // ver ExerciseType en src/types.ts
  phase       String @default("PRACTICE") // WARMUP | PRACTICE | PERFORMANCE
  prompt      String
  data        String // JSON blob (ver src/types.ts)
  explanation String @default("")

  attempts ExerciseAttempt[]

  @@unique([lessonId, index])
}

model ExerciseAttempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  correct    Boolean
  createdAt  DateTime @default(now())
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  status      String    @default("LOCKED") // LOCKED | AVAILABLE | COMPLETED
  stars       Int       @default(0)
  bestScore   Int       @default(0)
  attempts    Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
}

model XPEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  reason    String
  createdAt DateTime @default(now())
}

model Badge {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String
  icon        String

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}
