// t-clas · Piano Learning App
// Nota: los campos "tipo/estado" se guardan como String (en vez de enum)
// para mantener compatibilidad si en el futuro se usara otro motor;
// se validan en la capa de aplicacion (ver src/types.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   // "STUDENT" | "TEACHER"
  createdAt    DateTime @default(now())

  studentProfile StudentProfile?

  assignmentsGiven    Assignment[] @relation("TeacherAssignments")
  assignmentsReceived Assignment[] @relation("StudentAssignments")
  progress            Progress[]
  xpEvents            XPEvent[]
  badges              UserBadge[]
  exerciseAttempts    ExerciseAttempt[]
}

model StudentProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  ageGroup         String   // "KIDS" (6-11) | "TEENS" (12-17) | "ADULTS" (18+)
  birthYear        Int?
  trackId          String?
  track            Track?   @relation(fields: [trackId], references: [id])
  xpTotal          Int      @default(0)
  heartsCurrent     Int      @default(5)
  heartsMax         Int      @default(5)
  heartsUpdatedAt   DateTime @default(now())
  streakCurrent    Int      @default(0)
  streakLongest    Int      @default(0)
  lastActivityDate DateTime?
  onboarded        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model Track {
  id          String   @id @default(cuid())
  code        String   @unique // "kids" | "teens" | "adults"
  name        String
  description String
  minAge      Int
  maxAge      Int
  order       Int      @default(0)

  levels          Level[]
  studentProfiles StudentProfile[]
}

model Level {
  id          String @id @default(cuid())
  trackId     String
  track       Track  @relation(fields: [trackId], references: [id])
  index       Int
  title       String
  description String
  iconEmoji   String @default("🎹")

  units Unit[]

  @@unique([trackId, index])
}

model Unit {
  id          String @id @default(cuid())
  levelId     String
  level       Level  @relation(fields: [levelId], references: [id])
  index       Int
  title       String
  description String

  lessons Lesson[]

  @@unique([levelId, index])
}

model Lesson {
  id          String @id @default(cuid())
  unitId      String
  unit        Unit   @relation(fields: [unitId], references: [id])
  index       Int
  title       String
  description String
  xpReward    Int    @default(10)

  exercises Exercise[]
  progress  Progress[]
  assignments Assignment[]

  @@unique([unitId, index])
}

model Exercise {
  id          String @id @default(cuid())
  lessonId    String
  lesson      Lesson @relation(fields: [lessonId], references: [id])
  index       Int
  type        String // NOTE_NAME | STAFF_READING | RHYTHM_TAP | EAR_TRAINING | THEORY_MCQ | KEYBOARD_PLAY | INTERVAL | CHORD
  prompt      String
  data        String // JSON blob: options/correctAnswer/midiNotes/bpm/etc (see src/types.ts)
  explanation String @default("")

  attempts ExerciseAttempt[]

  @@unique([lessonId, index])
}

model ExerciseAttempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  correct    Boolean
  createdAt  DateTime @default(now())
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  status      String    @default("LOCKED") // LOCKED | AVAILABLE | COMPLETED
  stars       Int       @default(0)
  bestScore   Int       @default(0)
  attempts    Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
}

model XPEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  reason    String
  createdAt DateTime @default(now())
}

model Badge {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String
  icon        String

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model Assignment {
  id          String    @id @default(cuid())
  teacherId   String
  teacher     User      @relation("TeacherAssignments", fields: [teacherId], references: [id])
  studentId   String
  student     User      @relation("StudentAssignments", fields: [studentId], references: [id])
  lessonId    String?
  lesson      Lesson?   @relation(fields: [lessonId], references: [id])
  classDate   DateTime
  note        String    @default("")
  status      String    @default("PENDING") // PENDING | DONE
  createdAt   DateTime  @default(now())
}
