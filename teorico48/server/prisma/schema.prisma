generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  // Cuenta atras: fecha en la que el alumno tiene el examen real
  examDate     DateTime?

  // Monetizacion: pago unico "Pack 48h"
  isPremium        Boolean @default(false)
  stripeCustomerId String?

  // Gamificacion
  xp               Int       @default(0)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?

  // Recuperacion de contrasena: se guarda un hash del token, nunca el token en claro
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  // Verificacion de email: no bloquea el uso de la app, solo informa/anima a confirmar
  emailVerified        Boolean   @default(false)
  verifyTokenHash      String?
  verifyTokenExpiresAt DateTime?

  // Se incrementa al cambiar la contrasena para invalidar tokens JWT ya emitidos
  tokenVersion Int @default(0)

  // Aceptacion legal en el registro (fecha, para poder acreditarla)
  termsAcceptedAt DateTime?

  // IDs de las sesiones de Teoria Express ya completadas (s1, s2, s3...):
  // evita volver a dar la recompensa de XP si se repite una sesion.
  theoryCompletedSessions String[] @default([])

  attempts TestAttempt[]
  usedAccessCode AccessCode?

  @@map("users")
}

model AccessCode {
  id        String    @id @default(cuid())
  code      String    @unique
  note      String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  usedAt    DateTime?

  usedByUserId String? @unique
  usedByUser   User?   @relation(fields: [usedByUserId], references: [id])

  @@map("access_codes")
}

model Category {
  id   String @id @default(cuid())
  slug String @unique
  name String

  questions Question[]

  @@map("categories")
}

model Question {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  text        String
  imageUrl    String?
  options     Json // string[4]
  correctIndex Int
  explanation String
  // Etiqueta informativa para preguntas de temas especialmente delicados
  // (alcohol, drogas, velocidad...). No afecta a la puntuación del test:
  // la regla de aprobado es siempre "máximo 3 fallos de 30", igual que en
  // el examen real.
  isSerious   Boolean @default(false)

  answers Answer[]

  @@map("questions")
}

enum AttemptMode {
  practice
  exam
  learn
}

model TestAttempt {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  mode       AttemptMode
  startedAt  DateTime    @default(now())
  finishedAt DateTime?
  score      Int? // aciertos
  total      Int?
  passed     Boolean?

  answers Answer[]

  @@map("test_attempts")
}

model Answer {
  id            String      @id @default(cuid())
  attemptId     String
  attempt       TestAttempt @relation(fields: [attemptId], references: [id])
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id])
  selectedIndex Int?
  correct       Boolean

  @@map("answers")
}
